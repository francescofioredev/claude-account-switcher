#!/bin/sh
# Wrapper for the VS Code setting "claudeCode.claudeProcessWrapper".
#
# The Claude Code extension invokes it as:  claude-account-wrapper <claude-binary> <args...>
# so all we do here is set the environment and exec whatever we were handed.
#
# The cwd the extension launches us with is realpathSync(workspaceFolders[0]),
# i.e. the FIRST folder of the .code-workspace in multi-root workspaces.
#
# Two non-negotiable rules:
#  - on the default branch CLAUDE_CONFIG_DIR must be removed from the environment,
#    not set to its default value: setting it would change the Keychain namespace
#    and the default account would appear logged out;
#  - no set -e and no fatal errors: if claude-account is missing or broken, Claude
#    must still start on the default account.

dir=$("$(dirname "$0")/claude-account" resolve "$PWD" 2>/dev/null) || dir=

if [ -n "$dir" ]; then
  CLAUDE_CONFIG_DIR="$dir"
  export CLAUDE_CONFIG_DIR
else
  unset CLAUDE_CONFIG_DIR
fi

# Only now do we move, if the user picked a start folder: the account above was
# resolved from the window, so the two choices stay independent of each other.
# Claude takes its project root from the cwd, so this is what makes that folder's
# CLAUDE.md, hooks, skills and commands the ones in force.
# A cd that fails leaves the session where it was, like any other failure here.
start=$("$(dirname "$0")/claude-account" cwd "$PWD" 2>/dev/null) || start=
# redirected: with CDPATH set, cd prints the destination on stdout
[ -n "$start" ] && cd "$start" >/dev/null 2>&1

exec "$@"

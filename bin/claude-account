#!/bin/sh
# claude-account — pick the Claude Code account based on the project.
#
# Claude Code keeps one login per machine, but isolates credentials and state per
# CLAUDE_CONFIG_DIR: on macOS the Keychain service is "Claude Code-credentials"
# when the variable is unset, and "Claude Code-credentials-<sha256(dir)[0:8]>"
# when it is set. Several accounts can therefore stay logged in at once.
#
# This script is the single source of truth for "which account for which project".
# The VS Code wrapper, the shell hook and the extension all consult it.
#
# set -u yes, set -e NEVER: this script sits on Claude's startup path, so an error
# here must degrade to the default account, not stop Claude from launching.

set -u

VERSION=0.3.0
REPO_URL="https://github.com/francescofioredev/claude-account-switcher"

ACCOUNTS="$HOME/.claude-accounts"
DEFAULT_DIR="$HOME/.claude"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/claude-account"
ACCOUNTS_FILE="$CONF/accounts"
OVERRIDES="$CONF/overrides"
CWDS="$CONF/cwd"

# Files and directories of ~/.claude shared with every new slot via symlink.
# Everything account-specific or volatile stays out: .claude.json, ide/,
# sessions/, session-env/, shell-snapshots/, file-history/, history.jsonl,
# backups/, cache/, telemetry/.
SHARED="CLAUDE.md settings.json settings.local.json skills agents commands plugins hooks projects"

ACCOUNT=default
RESOLVED=
SOURCE=default

die() { printf '%s\n' "$*" >&2; exit 1; }

# Read a one-line file, stripping spaces and newlines.
read1() { tr -d ' \t\n\r' < "$1"; }

# Same, but for files holding a path: spaces are part of the value there.
readpath1() { sed -n '1p' "$1" | tr -d '\n\r'; }

# The same canonicalization the VS Code extension gets from realpathSync():
# without it, the slug written here would not match the one it looks up.
abspath() {
  if [ -d "$1" ]; then
    (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"
  else
    printf '%s' "$1"
  fi
}

slug_of() { printf '%s' "$1" | tr '/' '-'; }

# Accepts an account name. 'default' is reserved and means ~/.claude: it exists so
# the default can be pinned explicitly against what the table says.
# A name matching no slot fails and lets resolution continue to the next level,
# rather than pointing at a ghost slot.
try() {
  [ -n "${1:-}" ] || return 1
  case "$1" in .*|*/*) return 1 ;; esac
  if [ "$1" = default ]; then
    ACCOUNT=default; RESOLVED=; SOURCE=$2; return 0
  fi
  [ -d "$ACCOUNTS/$1" ] || return 1
  ACCOUNT=$1; RESOLVED="$ACCOUNTS/$1"; SOURCE=$2; return 0
}

# Precedence: UI override > marker file in the repo > table > default.
resolve() {
  d=$(abspath "${1:-$PWD}")

  ov="$OVERRIDES/$(slug_of "$d")"
  [ -f "$ov" ] && try "$(read1 "$ov")" override && return 0

  p=$d
  while [ -n "$p" ] && [ "$p" != "/" ]; do
    if [ -f "$p/.claude-account" ]; then
      try "$(read1 "$p/.claude-account")" marker && return 0
      break
    fi
    p=$(dirname "$p")
  done

  if [ -f "$ACCOUNTS_FILE" ]; then
    while read -r name prefix _; do
      case "$name" in ''|\#*) continue ;; esac
      [ -n "${prefix:-}" ] || continue
      case "$prefix" in "~"*) prefix="$HOME${prefix#\~}" ;; esac
      # the prefix needs canonicalizing too: $d already is, and a symlink anywhere
      # along the path (/var → /private/var on macOS) would silently block the match
      prefix=$(abspath "$prefix")
      case "$d" in "$prefix"|"$prefix"/*) try "$name" table && return 0 ;; esac
    done < "$ACCOUNTS_FILE"
  fi

  ACCOUNT=default; RESOLVED=; SOURCE=default
  return 0
}

# The folder the session starts in, pinned per window by the extension. Prints
# nothing when there is nothing usable to say: a pin left behind by a folder that
# was deleted or dropped from the workspace has to degrade to the window, not stop
# Claude from starting.
session_cwd() {
  d=$(abspath "${1:-$PWD}")
  f="$CWDS/$(slug_of "$d")"
  [ -f "$f" ] || return 0
  c=$(readpath1 "$f")
  case "$c" in /*) ;; *) return 0 ;; esac
  [ -d "$c" ] || return 0
  c=$(abspath "$c")
  [ "$c" = "$d" ] && return 0
  printf '%s\n' "$c"
}

# The config dir of an account, including the default.
dir_of() {
  if [ "$1" = default ]; then printf '%s' "$DEFAULT_DIR"; else printf '%s' "$ACCOUNTS/$1"; fi
}

# Where an account's .claude.json lives. Mind the asymmetry: for the default
# account it sits BESIDE the config dir (~/.claude.json), while with
# CLAUDE_CONFIG_DIR set it sits INSIDE it (<dir>/.claude.json).
json_of() {
  if [ "$1" = default ]; then printf '%s' "$HOME/.claude.json"; else printf '%s' "$ACCOUNTS/$1/.claude.json"; fi
}

# The email logged in to an account, read from its .claude.json (no process
# spawn). Empty if that account has never logged in.
email_of() {
  f=$(json_of "$1")
  [ -f "$f" ] || return 0
  sed -n 's/.*"emailAddress"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -1
}

# An account's Keychain service, derived from its config dir path.
# Slots only: the default uses "Claude Code-credentials" with no suffix, because
# there CLAUDE_CONFIG_DIR is not set at all.
keychain_service_of() {
  if [ "$1" = default ]; then
    printf 'Claude Code-credentials'
  else
    printf 'Claude Code-credentials-%s' \
      "$(printf '%s' "$(dir_of "$1")" | shasum -a 256 | cut -c1-8)"
  fi
}

# The usage fields are nested in .claude.json, which is pretty-printed: sed and awk
# are not enough (an awk extractor truncates resets_at at the "+00:00" and matches
# seven_day partially against seven_day_opus). This needs a real parser: jq, or node
# as a fallback because macOS 13/14 ship no system jq.
JSON=
have_json() {
  [ -n "$JSON" ] && return 0
  for c in /usr/bin/jq jq; do
    command -v "$c" >/dev/null 2>&1 && { JSON=$c; return 0; }
  done
  command -v node >/dev/null 2>&1 && { JSON=node; return 0; }
  return 1
}

# Emit the key=value usage lines for an account by reading its .claude.json.
# A missing field stays empty: never a fake zero, which would read as "nothing
# used" rather than "unknown".
# $2, if given, is the live endpoint response: the BARE utilization object, whereas
# in the cache the same object sits under .cachedUsageUtilization.utilization.
# Identity (email, plan) still comes from the file: the live response omits it.
usage_fields() {
  f=$(json_of "$1")
  [ -f "$f" ] || return 0
  have_json || return 0

  live=${2:-}
  lf=
  if [ -n "$live" ]; then
    lf=$(mktemp) || return 0
    printf '%s' "$live" > "$lf"
  fi

  if [ "$JSON" = node ]; then
    node -e '
      const fs = require("fs");
      let d; try { d = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); } catch { d = {}; }
      let L = null;
      if (process.argv[2]) { try { L = JSON.parse(fs.readFileSync(process.argv[2], "utf8")); } catch {} }
      const o = d.oauthAccount || {}, c = d.cachedUsageUtilization || {};
      const u = L ? (L.utilization || L) : (c.utilization || {});
      const p = (k, v) => { if (v !== undefined && v !== null) console.log(k + "=" + v); else console.log(k + "="); };
      // percentages come back float from the API (2.0) and integer from the cache
      const r = (v) => (v == null ? null : Math.round(Number(v)));
      p("email", o.emailAddress); p("display_name", o.displayName); p("org_name", o.organizationName);
      p("plan", o.organizationType); p("tier", o.organizationRateLimitTier);
      p("fetched_at_ms", L ? Date.now() : c.fetchedAtMs);
      p("live", L ? 1 : 0);
      for (const n of ["five_hour", "seven_day"]) {
        const w = u[n] || {};
        p(n + "_pct", r(w.utilization)); p(n + "_resets_at", w.resets_at);
      }
      const act = (u.limits || []).find((l) => l.is_active);
      p("active_limit", act && act.kind);
      const x = u.extra_usage || {}, s = u.spend || {};
      const on = x.is_enabled === true;
      p("extra_enabled", on ? 1 : 0);
      // spend.used.currency stays set even with extra_usage off, with every amount
      // null: inferring presence from the currency would show an empty row.
      p("spend_used_minor", on && s.used ? s.used.amount_minor : null);
      p("spend_limit_minor", on && s.limit ? s.limit.amount_minor : null);
      p("spend_currency", on && s.used ? s.used.currency : null);
      p("spend_exponent", on && s.used ? s.used.exponent : null);
      p("spend_pct", on ? r(s.percent) : null);
    ' "$f" "$lf" 2>/dev/null
    [ -n "$lf" ] && rm -f "$lf"
    return 0
  fi

  "$JSON" -r --arg now "$(_now_ms)" --slurpfile L "${lf:-/dev/null}" '
    def s: if . == null then "" else tostring end;
    def r: if . == null then "" else (tonumber | round | tostring) end;
    ($L[0] // null) as $lv
    | .oauthAccount as $o | (.cachedUsageUtilization // {}) as $c
    | (if $lv then ($lv.utilization // $lv) else ($c.utilization // {}) end) as $u
    | (($u.extra_usage // {}).is_enabled == true) as $on | ($u.spend // {}) as $sp
    | "email=\(($o.emailAddress) | s)",
      "display_name=\(($o.displayName) | s)",
      "org_name=\(($o.organizationName) | s)",
      "plan=\(($o.organizationType) | s)",
      "tier=\(($o.organizationRateLimitTier) | s)",
      "fetched_at_ms=\(if $lv then $now else ($c.fetchedAtMs | s) end)",
      "live=\(if $lv then 1 else 0 end)",
      "five_hour_pct=\((($u.five_hour // {}).utilization) | r)",
      "five_hour_resets_at=\((($u.five_hour // {}).resets_at) | s)",
      "seven_day_pct=\((($u.seven_day // {}).utilization) | r)",
      "seven_day_resets_at=\((($u.seven_day // {}).resets_at) | s)",
      "active_limit=\([($u.limits // [])[] | select(.is_active)][0].kind | s)",
      "extra_enabled=\(if $on then 1 else 0 end)",
      "spend_used_minor=\(if $on then ($sp.used.amount_minor | s) else "" end)",
      "spend_limit_minor=\(if $on then ($sp.limit.amount_minor | s) else "" end)",
      "spend_currency=\(if $on then ($sp.used.currency | s) else "" end)",
      "spend_exponent=\(if $on then ($sp.used.exponent | s) else "" end)",
      "spend_pct=\(if $on then ($sp.percent | r) else "" end)"
  ' "$f" 2>/dev/null
  [ -n "$lf" ] && rm -f "$lf"
  return 0
}

_now_ms() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import time;print(int(time.time()*1000))'
  else
    printf '%s000' "$(date +%s)"
  fi
}

# Asks /api/oauth/usage for current usage. Needed because cachedUsageUtilization in
# .claude.json is NOT refreshed every session: when sampled, the file was rewritten
# every few minutes while the field stayed put for hours. Without this call the
# panel shows yesterday's numbers.
#
# It is an internal, undocumented endpoint: if it changes, this degrades to the
# cache instead of breaking. The token goes to api.anthropic.com and nowhere else.
usage_live() {
  # Opt-in: without explicit consent no network request is made and the token is
  # not even read from the Keychain. Degrades to the cache.
  [ "${CLAUDE_ACCOUNT_USAGE_LIVE:-0}" = 1 ] || return 1
  command -v curl >/dev/null 2>&1 || return 1
  have_json || return 1

  tok=$(security find-generic-password -s "$(keychain_service_of "$1")" -w 2>/dev/null) || return 1
  [ -n "$tok" ] || return 1
  tok=$(printf '%s' "$tok" | _json_get_token) || return 1
  [ -n "$tok" ] || return 1

  # --max-time: this sits behind a UI refresh, it must not hang the window.
  body=$(curl -sS --max-time 8 \
    -H "Authorization: Bearer $tok" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "User-Agent: claude-account/$VERSION (+$REPO_URL)" \
    https://api.anthropic.com/api/oauth/usage 2>/dev/null) || return 1
  [ -n "$body" ] || return 1
  printf '%s' "$body" | grep -q '"utilization"\|"five_hour"\|"limits"' || return 1
  printf '%s' "$body"
}

_json_get_token() {
  if [ "$JSON" = node ]; then
    node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
      try { process.stdout.write((JSON.parse(s).claudeAiOauth||{}).accessToken||""); } catch {}
    })'
  else
    "$JSON" -r '.claudeAiOauth.accessToken // empty' 2>/dev/null
  fi
}

# The overrides naming a given account, one per line.
overrides_naming() {
  [ -d "$OVERRIDES" ] || return 0
  for f in "$OVERRIDES"/*; do
    [ -f "$f" ] || continue
    [ "$(read1 "$f")" = "$1" ] && printf '%s\n' "$f"
  done
  return 0
}

# How many table rows name a given account.
table_rows_naming() {
  [ -f "$ACCOUNTS_FILE" ] || { printf '0'; return 0; }
  n=0
  while read -r name _; do
    case "$name" in ''|\#*) continue ;; esac
    [ "$name" = "$1" ] && n=$((n+1))
  done < "$ACCOUNTS_FILE"
  printf '%s' "$n"
}

cmd_resolve() {
  resolve "${1:-}"
  [ -n "$RESOLVED" ] && printf '%s\n' "$RESOLVED"
  return 0
}

cmd_status() {
  resolve "${1:-}"
  printf 'account=%s\n' "$ACCOUNT"
  printf 'config_dir=%s\n' "$(dir_of "$ACCOUNT")"
  printf 'json=%s\n' "$(json_of "$ACCOUNT")"
  printf 'source=%s\n' "$SOURCE"
  printf 'path=%s\n' "$(abspath "${1:-$PWD}")"
  printf 'email=%s\n' "$(email_of "$ACCOUNT")"
  printf 'cwd=%s\n' "$(session_cwd "${1:-}")"
}

# list           human-readable table
# list --porcelain   <name>TAB<email>TAB<config_dir>TAB<json>TAB<logged>TAB<keychain>,
#                    for the extension: knowing where each .claude.json lives stays
#                    this script's job alone. Columns are APPENDED at the end, never
#                    reordered: the extension destructures them by position.
cmd_list() {
  fmt=${1:-human}
  _row default "$fmt"
  if [ -d "$ACCOUNTS" ]; then
    for d in "$ACCOUNTS"/*; do
      [ -d "$d" ] || continue
      _row "$(basename "$d")" "$fmt"
    done
  fi
}

_row() {
  email=$(email_of "$1")
  if [ "${2:-human}" = "--porcelain" ]; then
    [ -n "$email" ] && logged=1 || logged=0
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$1" "$email" "$(dir_of "$1")" "$(json_of "$1")" "$logged" "$(keychain_service_of "$1")"
  else
    [ -n "$email" ] || email="(never logged in)"
    printf '%-14s %-38s %s\n' "$1" "$email" "$(dir_of "$1")"
  fi
}

# usage [--porcelain] [name]
#
# key=value records separated by '---', one per account. The data comes from
# cachedUsageUtilization, written by Claude Code itself: it only updates when Claude
# runs on that account, so fetched_at_ms must always be shown to the reader.
# resets_at stays raw ISO: BSD date does not parse "+00:00" offsets, so the
# countdown is computed downstream.
cmd_usage() {
  fmt=human; who=; want_live=0
  for a in "$@"; do
    case "$a" in
      --porcelain) fmt=--porcelain ;;
      --live) want_live=1 ;;
      *) who=$a ;;
    esac
  done

  if [ -n "$who" ]; then
    [ "$who" = default ] || [ -d "$ACCOUNTS/$who" ] || die "no such account: $who"
    set -- "$who"
  else
    set -- default
    if [ -d "$ACCOUNTS" ]; then
      for d in "$ACCOUNTS"/*; do
        [ -d "$d" ] && set -- "$@" "$(basename "$d")"
      done
    fi
  fi

  for n in "$@"; do
    email=$(email_of "$n")
    [ -n "$email" ] && logged=1 || logged=0
    live=
    # if the endpoint does not answer we fall back to the cache: stale data beats no
    # data, as long as it stays labelled as such (live=0)
    [ "$want_live" = 1 ] && [ "$logged" = 1 ] && live=$(usage_live "$n")

    if [ "$fmt" = --porcelain ]; then
      printf 'name=%s\n' "$n"
      printf 'config_dir=%s\n' "$(dir_of "$n")"
      printf 'logged_in=%s\n' "$logged"
      if [ "$logged" = 1 ]; then usage_fields "$n" "$live"; else printf 'email=\n'; fi
      printf -- '---\n'
    else
      _usage_human "$n" "$logged" "$live"
    fi
  done
  return 0
}

_usage_human() {
  if [ "$2" = 0 ]; then
    printf '%-14s (never logged in)\n' "$1"
    return 0
  fi
  u=$(usage_fields "$1" "${3:-}")
  get() { printf '%s\n' "$u" | sed -n "s/^$1=//p" | head -1; }
  printf '%-14s %s\n' "$1" "$(get email)"
  for w in five_hour:5h seven_day:7d; do
    k=${w%%:*}; lbl=${w##*:}
    p=$(get "${k}_pct")
    [ -n "$p" ] || continue
    printf '  %-3s %s %3s%%\n' "$lbl" "$(_bar "$p")" "$p"
  done
  ms=$(get fetched_at_ms)
  if [ "$(get live)" = 1 ]; then printf '  updated: just now (live)\n'
  elif [ -n "$ms" ]; then printf '  updated: %s (cached)\n' "$(_age "$ms")"; fi
  return 0
}

_bar() {
  n=$(( ${1:-0} / 5 ))
  [ "$n" -gt 20 ] && n=20
  i=0; out=
  while [ "$i" -lt 20 ]; do
    [ "$i" -lt "$n" ] && out="$out#" || out="$out."
    i=$((i+1))
  done
  printf '%s' "$out"
}

_age() {
  now=$(date +%s)
  then=$(( ${1:-0} / 1000 ))
  m=$(( (now - then) / 60 ))
  if [ "$m" -lt 1 ]; then printf 'just now'
  elif [ "$m" -lt 60 ]; then printf '%s min ago' "$m"
  elif [ "$m" -lt 1440 ]; then printf '%sh ago' "$((m / 60))"
  elif [ "$m" -lt 2880 ]; then printf 'yesterday'
  else printf '%s days ago' "$((m / 1440))"; fi
}

# Print an account's login line and nothing else, so the extension pastes text
# written here instead of rebuilding paths on its own.
# For the default the variable must be OMITTED, not set to ~/.claude: setting it
# changes the Keychain namespace (same rule as the wrapper).
cmd_login_cmd() {
  name=${1:-default}
  [ "$name" = default ] || [ -d "$ACCOUNTS/$name" ] || die "no such account: $name"
  if [ "$name" = default ]; then
    printf 'claude auth login\n'
  else
    printf 'CLAUDE_CONFIG_DIR=%s claude auth login\n' "$(dir_of "$name")"
  fi
}

cmd_logout() {
  name=${1:-}
  [ -n "$name" ] || die "usage: claude-account logout <name|default>"
  [ "$name" = default ] || [ -d "$ACCOUNTS/$name" ] || die "no such account: $name"

  if command -v claude >/dev/null 2>&1; then
    if [ "$name" = default ]; then
      claude auth logout >/dev/null 2>&1
    else
      CLAUDE_CONFIG_DIR="$(dir_of "$name")" claude auth logout >/dev/null 2>&1
    fi
  fi
  # Belt and braces: if claude is missing or logout did not clean up, the entry goes anyway.
  security delete-generic-password -s "$(keychain_service_of "$name")" >/dev/null 2>&1

  printf 'logged out %s\n' "$name"
  printf 'to log back in:\n  %s\n' "$(cmd_login_cmd "$name")"
}

cmd_rm() {
  name=; force=0
  for a in "$@"; do
    case "$a" in --force) force=1 ;; *) name=$a ;; esac
  done
  [ -n "$name" ] || die "usage: claude-account rm <name> [--force]"
  case "$name" in default) die "'default' cannot be deleted: it is the account in $DEFAULT_DIR" ;; esac
  case "$name" in .*|*/*) die "invalid name: $name" ;; esac
  dst="$ACCOUNTS/$name"
  [ -d "$dst" ] || die "no such account: $name"

  # rm -rf does not follow symlinks (it unlinks entries, recursing only into real
  # dirs), so the targets in ~/.claude are safe. The real risk is config that was
  # copied instead of symlinked: those files are unique and would be gone forever.
  real=
  for f in $SHARED; do
    [ -e "$dst/$f" ] && [ ! -L "$dst/$f" ] && real="$real $f"
  done
  if [ -n "$real" ] && [ "$force" = 0 ]; then
    printf '%s holds real copies (not symlinks) of shared config:\n' "$dst" >&2
    for f in $real; do printf '  %s\n' "$f" >&2; done
    die "deleting it would lose them. Use --force if that is what you want."
  fi

  svc=$(keychain_service_of "$name")
  had_key=0
  security find-generic-password -s "$svc" >/dev/null 2>&1 && had_key=1
  security delete-generic-password -s "$svc" >/dev/null 2>&1

  rm -rf "$dst" || die "cannot remove $dst"
  printf 'removed %s\n' "$dst"
  [ "$had_key" = 1 ] && printf 'Keychain credentials removed (%s)\n' "$svc"

  n=0
  for f in $(overrides_naming "$name"); do rm -f "$f"; n=$((n+1)); done
  [ "$n" -gt 0 ] && printf "removed %s overrides pointing at '%s'\n" "$n" "$name"

  # The table is hand-written, with comments and alignment: just warn about it.
  # This is not a correctness problem — try() filters on the dir existing and
  # resolution degrades to the next level.
  t=$(table_rows_naming "$name")
  [ "$t" -gt 0 ] && printf "warning: %s rows in %s still point at '%s'\n" "$t" "$ACCOUNTS_FILE" "$name"
  return 0
}

# Renaming moves the config dir, and the Keychain service is sha256(dir)[0:8]: after
# a mv the credentials are orphaned and the account looks present but logged out.
# Better to remove them and say so than to leave the user a ghost login.
cmd_rename() {
  old=${1:-}; new=${2:-}
  [ -n "$old" ] && [ -n "$new" ] || die "usage: claude-account rename <old> <new>"
  case "$old" in default) die "'default' cannot be renamed" ;; esac
  case "$new" in default) die "'default' is reserved" ;; esac
  case "$new" in .*|*/*) die "invalid name: $new" ;; esac
  [ -d "$ACCOUNTS/$old" ] || die "no such account: $old"
  [ -e "$ACCOUNTS/$new" ] && die "already exists: $new"

  svc=$(keychain_service_of "$old")
  mv "$ACCOUNTS/$old" "$ACCOUNTS/$new" || die "cannot rename $old"
  security delete-generic-password -s "$svc" >/dev/null 2>&1

  # Overrides are single-token files written by the machine: rewriting them is safe.
  for f in $(overrides_naming "$old"); do printf '%s\n' "$new" > "$f"; done

  printf 'renamed %s → %s\n' "$old" "$new"
  printf 'WARNING: credentials were tied to the old path and have been removed.\n'
  printf 'Log in again:\n  %s\n' "$(cmd_login_cmd "$new")"

  t=$(table_rows_naming "$old")
  [ "$t" -gt 0 ] && printf "warning: %s rows in %s still point at '%s'\n" "$t" "$ACCOUNTS_FILE" "$old"
  return 0
}

cmd_new() {
  name=${1:-}
  [ -n "$name" ] || die "usage: claude-account new <name>"
  case "$name" in default) die "'default' is reserved: it is the account in $DEFAULT_DIR" ;; esac
  case "$name" in .*|*/*) die "invalid name: $name" ;; esac
  [ -d "$DEFAULT_DIR" ] || die "$DEFAULT_DIR not found: has Claude Code ever been started?"

  dst="$ACCOUNTS/$name"
  mkdir -p "$dst" || die "cannot create $dst"
  for f in $SHARED; do
    [ -e "$DEFAULT_DIR/$f" ] || continue
    [ -e "$dst/$f" ] || [ -L "$dst/$f" ] || ln -s "$DEFAULT_DIR/$f" "$dst/$f"
  done

  printf 'created %s (config shared with %s via symlinks)\n' "$dst" "$DEFAULT_DIR"
  printf 'now log in:\n  CLAUDE_CONFIG_DIR=%s claude auth login\n' "$dst"
}

cmd_use() {
  name=${1:-}
  [ -n "$name" ] || die "usage: claude-account use <name|default> [path]"
  [ "$name" = default ] || [ -d "$ACCOUNTS/$name" ] || die "no such account: $name (see: claude-account list)"
  d=$(abspath "${2:-$PWD}")
  mkdir -p "$OVERRIDES" || die "cannot create $OVERRIDES"
  printf '%s\n' "$name" > "$OVERRIDES/$(slug_of "$d")"
  printf '%s → %s\n' "$d" "$name"
}

cmd_clear() {
  d=$(abspath "${1:-$PWD}")
  rm -f "$OVERRIDES/$(slug_of "$d")"
  printf '%s → project default\n' "$d"
}

cmd_cwd() {
  session_cwd "${1:-}"
  return 0
}

# Pinning a start folder does not touch the account: the wrapper resolves the
# account from the window and only then moves.
cmd_set_cwd() {
  t=${1:-}
  [ -n "$t" ] || die "usage: claude-account set-cwd <folder> [path]"
  [ -d "$t" ] || die "no such folder: $t"
  t=$(abspath "$t")
  d=$(abspath "${2:-$PWD}")
  mkdir -p "$CWDS" || die "cannot create $CWDS"
  printf '%s\n' "$t" > "$CWDS/$(slug_of "$d")"
  printf '%s → starts in %s\n' "$d" "$t"
}

cmd_clear_cwd() {
  d=$(abspath "${1:-$PWD}")
  rm -f "$CWDS/$(slug_of "$d")"
  printf '%s → starts in itself\n' "$d"
}

cmd_help() {
  cat <<EOF
claude-account — one Claude Code account per project

  resolve [path]        print the config dir to use (empty = default account)
  status  [path]        account / config_dir / source / path / email / cwd
  list                  available accounts and who is logged in to each
  usage [--live] [name] usage (5h, 7 days, credit). --live asks the API
  new <name>            create the slot ~/.claude-accounts/<name>
  use <name|default> [path]   pin an account to that project
  clear [path]          remove the pin, back to the project default
  cwd [path]            print the folder the session starts in (empty = the path itself)
  set-cwd <folder> [path]     start the session in <folder> instead of the path
  clear-cwd [path]      remove the start folder, back to the path itself
  login-cmd <name>      print the login line for that account
  logout <name>         log the account out and remove its credentials
  rename <old> <new>    rename a slot (requires logging in again)
  rm <name> [--force]   delete the slot, its credentials and its overrides

Precedence: override (use) > .claude-account file in the repo > $ACCOUNTS_FILE > default.

set-cwd is independent of all of that: it moves the session's working directory, so
it picks up that folder's CLAUDE.md, hooks, skills and commands, while the account
keeps being resolved from the path the editor launched Claude in.

Without --live, usage comes from the cache in .claude.json, which Claude Code refreshes
rarely: it can be days old. With --live it asks the API, reading the token from the
Keychain; if that fails it falls back to the cache.

--live is opt-in: it only makes a network request when CLAUDE_ACCOUNT_USAGE_LIVE=1.
Otherwise it returns cached values. See SECURITY.md.
EOF
}

if [ $# -eq 0 ]; then set -- help; fi
cmd=$1
shift

case "$cmd" in
  resolve)       cmd_resolve "$@" ;;
  status)        cmd_status  "$@" ;;
  list)          cmd_list    "$@" ;;
  usage)         cmd_usage   "$@" ;;
  new)           cmd_new     "$@" ;;
  use)           cmd_use     "$@" ;;
  clear)         cmd_clear   "$@" ;;
  cwd)           cmd_cwd     "$@" ;;
  set-cwd)       cmd_set_cwd "$@" ;;
  clear-cwd)     cmd_clear_cwd "$@" ;;
  login-cmd)     cmd_login_cmd "$@" ;;
  logout)        cmd_logout  "$@" ;;
  rename)        cmd_rename  "$@" ;;
  rm|delete)     cmd_rm      "$@" ;;
  help|-h|--help) cmd_help ;;
  *)             die "unknown command: $cmd (try: claude-account help)" ;;
esac
